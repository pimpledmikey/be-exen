# be-exen.com: .htaccess de public_html.
# Generado por scripts/write-htaccess.mjs; no editar a mano. No viaja por Git:
# cuando cambia se copia a public_html/.htaccess (docs/despliegue.md).
#
# El sitio está en public_html/sitio/, donde Hostinger clona con Git la rama
# sitio-estatico. Estas reglas lo sirven en la raíz del dominio; los
# subdominios y public_html/plataforma no cambian.

ErrorDocument 404 /sitio/404.html

# Caché del navegador: las mismas reglas que tenía el sitio anterior (también
# aplican a las carpetas vecinas), salvo el HTML, que se revalida siempre para
# que los cambios del sitio se vean al momento.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/pdf "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresDefault "access plus 1 weeks"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Solo be-exen.com: los subdominios (como plataforma.be-exen.com) siguen igual.
RewriteCond %{HTTP_HOST} !^(www\.)?be-exen\.com$ [NC]
RewriteRule ^ - [L]

RewriteRule ^plataforma(/|$) - [L]
RewriteRule ^\.well-known/ - [L]

# Los datos de Git de la copia publicada nunca se sirven.
RewriteRule (^|/)\.git(/|$) - [F,L]

# /sitio/ no es una dirección pública: redirige a la raíz.
RewriteCond %{THE_REQUEST} \s/+sitio[/?\s]
RewriteRule ^sitio/?(.*)$ /$1 [R=301,L]
RewriteRule ^sitio/ - [L]

# URLs del sitio anterior (WordPress).
RewriteRule ^residencial/?$ /#soluciones [R=301,L,NE]
RewriteRule ^comercio/?$ /#soluciones [R=301,L,NE]
RewriteRule ^industria/?$ /#soluciones [R=301,L,NE]
RewriteRule ^sunpower/?$ /#soluciones [R=301,L,NE]
RewriteRule ^nosotros-2nosotros/?$ /#nosotros [R=301,L,NE]
RewriteRule ^clientes/?$ /#proyectos [R=301,L,NE]
RewriteRule ^vinculos/?$ /#nosotros [R=301,L,NE]
RewriteRule ^contacto/?$ /#contacto [R=301,L,NE]
RewriteRule ^blog/?$ / [R=301,L,NE]
RewriteRule ^2021(/.*)?$ / [R=301,L,NE]
RewriteRule ^2022(/.*)?$ / [R=301,L,NE]
RewriteRule ^category(/.*)?$ / [R=301,L,NE]
RewriteRule ^author(/.*)?$ / [R=301,L,NE]
RewriteRule ^feed/?$ / [R=301,L,NE]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L,NE]
RewriteRule ^page-sitemap\.xml$ /sitemap.xml [R=301,L,NE]
RewriteRule ^post-sitemap\.xml$ /sitemap.xml [R=301,L,NE]
RewriteRule ^category-sitemap\.xml$ /sitemap.xml [R=301,L,NE]
RewriteRule ^author-sitemap\.xml$ /sitemap.xml [R=301,L,NE]
RewriteRule ^e-landing-page-sitemap\.xml$ /sitemap.xml [R=301,L,NE]

# Carpetas sin barra final: la barra se añade en la dirección pública.
RewriteCond %{DOCUMENT_ROOT}/sitio/$1 -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# Todo lo demás sale de public_html/sitio/; lo que no existe ahí recibe la
# página 404 del sitio. El resto de public_html, incluido lo que quede de
# WordPress, deja de ser accesible desde el dominio.
RewriteRule ^(.*)$ /sitio/$1 [L]
</IfModule>
